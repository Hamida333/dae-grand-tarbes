# ======================================================
# DAE Grand Tarbes — Variables d'environnement
# Copiez ce fichier en .env.local et remplissez les valeurs
# Ne committez JAMAIS .env.local sur Git !
# ======================================================

# --- AIRTABLE (base de données gratuite) ---
# Créez votre compte sur https://airtable.com
# Allez dans Account > Developer hub > Personal Access Token
AIRTABLE_TOKEN=patXXXXXXXXXXXXXX.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Trouvez votre Base ID dans l'URL de votre base Airtable (commence par "app")
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX
# Noms des tables dans Airtable
AIRTABLE_TABLE_DAE=DAE
AIRTABLE_TABLE_CORRECTIONS=Corrections

# --- EMAIL (notifications) ---
# Utilisez Resend (gratuit 100 emails/jour) : https://resend.com
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Email de l'administrateur qui reçoit les notifications
ADMIN_EMAIL=votre-email@mairie-tarbes.fr
# Email expéditeur (doit être un domaine vérifié sur Resend)
FROM_EMAIL=dae-notifications@votre-domaine.fr

# --- ADMIN ---
# Mot de passe pour accéder à l'interface d'administration
# Changez ce mot de passe avant de déployer !
ADMIN_PASSWORD=changez-ce-mot-de-passe-2025

# --- GEOCODAGE ---
# API Nominatim (OpenStreetMap, gratuit) — utilisée pour convertir adresses en GPS
NOMINATIM_URL=https://nominatim.openstreetmap.org
